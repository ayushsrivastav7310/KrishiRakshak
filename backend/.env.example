APP_ENV=development
PORT=8000
APP_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DEMO_AUTH=true
DEMO_OTP=123456
DATABASE_PATH=./data/krishi.sqlite
UPLOAD_DIR=./data/uploads
# Optional server-side government data key; never put this in a VITE_ variable.
DATA_GOV_API_KEY=


# Inbound Twilio voice: all values remain server-only. Public URL must be an HTTPS origin.
VOICE_ENABLED=false
VOICE_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Durable Vercel storage (server-only). Use a Turso database, not a local replica.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PHOTO_STORAGE=local
# Set PHOTO_STORAGE=vercel-blob on Vercel and connect a PRIVATE Blob store.
# Vercel supplies BLOB_STORE_ID and OIDC credentials through the store connection.

